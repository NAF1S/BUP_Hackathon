# ---------------------------------------------------------------------------
# GridWise service configuration.
# Copy to `.env` and fill in. NEVER commit a filled-in `.env`.
# The variable NAMES documented here are part of the submission contract.
# ---------------------------------------------------------------------------

# --- HTTP server -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- LLM (operator-note interpretation; mandatory part of the judged path) --
# Any OpenAI-compatible endpoint works: DeepSeek, OpenAI, Groq, Together,
# OpenRouter, vLLM, Ollama, ...
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=18
LLM_MAX_RETRIES=2
LLM_JSON_MODE=true
LLM_MAX_CONCURRENCY=8

# --- Recovery policy -------------------------------------------------------
# When the LLM output fails deterministic guardrails, retry once with the
# validation error, then fall back to the built-in rule-based interpreter.
ALLOW_DETERMINISTIC_FALLBACK=true

# --- Request strictness (optional) -----------------------------------------
# Off by default. Section 07 requires the request to contain "exactly 24 entries
# for hours 0 through 23" but requires ASCENDING order only of the response
# (Section 5.1 and Section 08). Leave this false unless a harness you control
# insists on rejecting a merely unordered request `hours` array.
STRICT_HOUR_ORDER=false

# --- Response cache (identical scenarios answered instantly) ---------------
CACHE_SIZE=512
CACHE_TTL_SECONDS=3600

# --- Numerics --------------------------------------------------------------
NUMERIC_TOLERANCE=0.01
# Optional secondary objective coefficient (BDT per kWh of battery throughput)
# used only to prefer cleaner schedules among equal-cost optima. Keep at 0 to
# guarantee a pure cost optimum.
BATTERY_CYCLING_EPSILON=0

# --- Guard -------------------------------------------------------------
# Hard cap on total request handling time, below the 30s judge timeout.
REQUEST_TIMEOUT_SECONDS=25

# --- Testing / hermetic processes ------------------------------------------
# Set to 1 to stop this file from being loaded at all. The test suite sets it
# so a local .env can never inject real credentials into tests.
# DISABLE_DOTENV=1
